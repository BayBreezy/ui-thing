{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "ignorePatterns": ["**/*.md"],
  "sortTailwindcss": {
    "functions": ["tv", "tw"],
    "attributes": [":class"]
  },
  "jsdoc": { "bracketSpacing": true, "descriptionWithDot": true, "separateReturnsFromParam": true },
  "sortImports": true,
  "vueIndentScriptAndStyle": true,
  "sortPackageJson": { "sortScripts": true }
}
