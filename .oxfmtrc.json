{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "arrowParens": "always",
  "endOfLine": "lf",
  "trailingComma": "es5",
  "sortTailwindcss": {
    "stylesheet": "./app/assets/css/tailwind.css",
    "functions": ["tv", "tw"],
    "attributes": [":class"]
  },
  "sortImports": true,
  "vueIndentScriptAndStyle": true,
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "<TYPES>", "", "^[.]"],
  "sortPackageJson": true
}
